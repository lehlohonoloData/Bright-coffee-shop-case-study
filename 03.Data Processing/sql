----most transaction in the store location--
 SELECT  store_location,
    COUNT(DISTINCT transaction_id) AS total_transactions,
    SUM(transaction_qty) AS total_units_sold,
    SUM(transaction_qty * unit_price) AS total_revenue,
    ROUND(SUM(transaction_qty * unit_price) / COUNT(DISTINCT transaction_id), 2) AS avg_transaction_value
  FROM `brightlearn_catalog`.`default`.`bright_coffee_shop`
GROUP BY store_location
ORDER BY total_revenue DESC;  
----------------------------------
WITH monthly_sales AS (
    SELECT 
        store_location,
        DATE_TRUNC('month', transaction_date) AS sales_month,
        SUM(transaction_qty * unit_price) AS monthly_revenue
    FROM `brightlearn_catalog`.`default`.`bright_coffee_shop`
    WHERE store_location = 'Lower Manhattan'-----wrong
    GROUP BY store_location, DATE_TRUNC('month', transaction_date)
)
SELECT 
    sales_month,
    monthly_revenue,
    LAG(monthly_revenue) OVER (ORDER BY sales_month) AS previous_month_revenue,
    ROUND(
        (monthly_revenue - LAG(monthly_revenue) OVER (ORDER BY sales_month)) ---wrong
        / NULLIF(LAG(monthly_revenue) OVER (ORDER BY sales_month), 0) * 100, 
        2
    ) AS pct_revenue_decline
FROM monthly_sales
ORDER BY sales_month;
