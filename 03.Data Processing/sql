 select
       transaction_date,

 dayname(transaction_date) as day_name,
 
 count(transaction_id) as numbers_of_sales,
 sum(transaction_qty)as unit_sold,
 count(distinct product_id) as unique_products,
 count(store_id) as number_of_stores,
 sum (unit_price*transaction_qty) as revenue,

 case
     when day_name in ('Sat','Sun') then 'Weekend'
    when day_name in ('Mon','Tue','Wed','Thu','Fri') then 'Weekday'
 end as day_classification,

 case
   when transaction_time between '06:00:00' and '11:59:00' then '01.Early Morning' 
   when transaction_time between '12:00:00' and '17:59:00' then '02.Afternoon'
   when transaction_time between '18:00:00' and '21:59:00' then '03.Evening'
 end as time_classfication,

 monthname(transaction_date)as month_name,
 product_category,
 product_type,
 store_location,
 product_detail
 from `brightlearn_catalog`.`default`.`bright_coffee_shop`
 group by
  transaction_date,
  store_location,
  dayname(transaction_date),
  product_type,
  product_category,
  product_detail,
  case
   when transaction_time between '06:00:00' and '11:59:00' then '01.Early Morning' 
   when transaction_time between '12:00:00' and '17:59:00' then '02.Afternoon'
   when transaction_time between '18:00:00' and '21:59:00' then '03.Evening'
  end,
  case
     when dayname(transaction_date) in ('Sat','Sun') then 'Weekend'
    when dayname(transaction_date) in ('Mon','Tue','Wed','Thu','Fri') then 'Weekday'
  end;
